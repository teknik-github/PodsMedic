# LLM provider: "anthropic" (default) or "openai" for any OpenAI-compatible
# endpoint. "deepseek" is accepted as an alias that points the openai path at
# DeepSeek and defaults the model to deepseek-chat.
PODSMEDIC_PROVIDER=anthropic

# --- provider=anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- provider=openai / deepseek ---
# Key resolves in order: PODSMEDIC_API_KEY, DEEPSEEK_API_KEY, OPENAI_API_KEY
PODSMEDIC_API_KEY=
PODSMEDIC_BASE_URL=https://api.deepseek.com   # any OpenAI-compatible base
# PODSMEDIC_MODEL=deepseek-chat               # or deepseek-reasoner, gpt-4o, ...

# At least one sink, unless PODSMEDIC_DRY_RUN=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# Telegram two-way chat: as well as pushing alerts, listen for questions and
# answer them. OFF by default — it is an inbound channel that exposes cluster
# state and spends tokens, so turning it on is a deliberate act.
# It is answer-only: a chat message can never make podsmedic change the cluster.
PODSMEDIC_TELEGRAM_LISTEN=false
# Chat IDs allowed to ask. Defaults to TELEGRAM_CHAT_ID. An empty list serves
# nobody — a bot's username is discoverable, so this is what keeps strangers out.
PODSMEDIC_TELEGRAM_ALLOWED_CHATS=
PODSMEDIC_CHAT_MAX_PER_MINUTE=6           # questions per chat per minute; 0 = unlimited

# Live cluster view: a globe with your workloads around it and a wire drawn to
# each one as something happens. OFF by default, and on its own port rather than
# joining /metrics — it shows every workload name and every change podsmedic
# made, and it has NO AUTHENTICATION. Reach it with kubectl port-forward:
#   kubectl -n podsmedic port-forward deploy/podsmedic 3456:3456
# Enabling it also starts a pod watch, so the view updates in seconds rather
# than once per sweep. That costs one extra watch connection and an informer
# cache of the pods you watch.
PODSMEDIC_UI_ADDR=                        # e.g. 0.0.0.0:3456 to enable
PODSMEDIC_UI_EVENT_BUFFER=200             # recent events replayed to a new viewer

# Kubernetes
KUBECONFIG=
PODSMEDIC_NAMESPACES=            # comma-separated; empty = all namespaces
PODSMEDIC_INTERVAL=60s
PODSMEDIC_LOG_TAIL_LINES=120
PODSMEDIC_MAX_EVENTS=25
PODSMEDIC_MIN_RESTARTS=3
PODSMEDIC_RESTART_WINDOW=1h       # restarts older than this do not count as a storm
PODSMEDIC_NOT_READY_GRACE=10m     # how long a pod may stay not-ready before alerting
# How long a scheduled pod may sit in ContainerCreating before its volumes are
# presumed stuck. Attaching a cloud disk legitimately takes tens of seconds, so
# do not make this aggressive.
PODSMEDIC_VOLUME_MOUNT_GRACE=2m

# Alert throttling
PODSMEDIC_COOLDOWN=30m           # an incident resolves after this long unseen (then can re-alert)
PODSMEDIC_MAX_ALERTS_PER_CYCLE=10
PODSMEDIC_CONCURRENCY=3

# LLM
PODSMEDIC_MODEL=claude-opus-4-8  # defaults per provider; overrides both
PODSMEDIC_EFFORT=high            # anthropic only: low | medium | high | xhigh | max
PODSMEDIC_MAX_TOKENS=8000
# Cost accounting: USD per million tokens. Zero (default) counts tokens but not
# dollars. Set to your provider's rates, e.g. DeepSeek deepseek-chat ~0.27/1.10.
PODSMEDIC_LLM_PRICE_INPUT=0
PODSMEDIC_LLM_PRICE_OUTPUT=0

# Auto-heal — off by default. Two switches: AUTOHEAL turns the feature on
# (proposals validated + previewed), HEAL_APPLY actually mutates the cluster.
# With AUTOHEAL=true and HEAL_APPLY=false you get server-side dry runs only.
PODSMEDIC_AUTOHEAL=false
PODSMEDIC_HEAL_APPLY=false
PODSMEDIC_HEAL_MIN_CONFIDENCE=high        # only heal at/above this confidence
PODSMEDIC_HEAL_KINDS=OOMKilled            # eligible kinds; add ImagePullBackOff (patch_image), MemoryPressure (predictive), CPUPressure (scale)
# Patching requests moves the scheduling floor and can strand a pod as Pending,
# so it is off by default: only limits are raised. When enabled, a proposed
# request is additionally rejected if it exceeds a node's total allocatable.
PODSMEDIC_HEAL_PATCH_REQUESTS=false
PODSMEDIC_HEAL_MAX_MEMORY=4Gi             # absolute ceiling for a memory bump
PODSMEDIC_HEAL_MAX_CPU=4                  # absolute ceiling for a cpu bump
PODSMEDIC_HEAL_MAX_MULTIPLIER=4           # max growth vs the current value
# patch_probe caps: a probe may be loosened up to these ceilings, never past.
PODSMEDIC_HEAL_MAX_PROBE_DELAY=600        # max initialDelaySeconds
PODSMEDIC_HEAL_MAX_PROBE_PERIOD=300       # max periodSeconds
PODSMEDIC_HEAL_MAX_PROBE_TIMEOUT=60       # max timeoutSeconds
PODSMEDIC_HEAL_MAX_PROBE_FAILURES=20      # max failureThreshold
# scale_replicas: podsmedic works out the replica count itself, from the
# workload's measured CPU utilisation and the cluster's free capacity.
#   auto  (default) derive it; capacity and HEAL_MAX_MULTIPLIER are the bounds
#   0               disable scaling entirely
#   <number>        still derive it, but never exceed this hand-set backstop
PODSMEDIC_HEAL_MAX_REPLICAS=auto
PODSMEDIC_HEAL_SCALE_TARGET_CPU=0.70      # utilisation a derived scale-up aims to reach
# Fraction of every node's allocatable held back and never offered to a heal.
# This is the guard against healing the cluster into unresponsiveness: pods burst
# above their requests, and rescheduling needs somewhere to go. Raising it makes
# podsmedic more conservative about adding or enlarging pods.
PODSMEDIC_HEAL_CAPACITY_RESERVE=0.20

# Storage recovery. Two bounded actions, both opt-in via HEAL_KINDS:
#   restart_workload — recovers a pod stuck on a stale mount, but ONLY once every
#     claim it mounts is Bound again. Touches no storage object.
#   create_pvc       — creates a claim a pod references that was never created.
#     The only thing podsmedic ever creates, and the only storage write it has.
# Neither can edit, resize, detach, or delete a volume. A claim that exists is
# never touched, whatever state it is in.
PODSMEDIC_PVC_AUTOCREATE=false            # master switch for create_pvc
PODSMEDIC_PVC_DEFAULT_SIZE=1Gi            # size for a created claim; the model has no say
PODSMEDIC_PVC_DEFAULT_CLASS=              # empty = cluster default StorageClass
PODSMEDIC_PVC_MAX_SIZE=10Gi               # hard ceiling; a larger default is capped to this
# create_pvc additionally requires an explicit namespace allowlist below —
# provisioning storage cluster-wide by default is never the intent.
# PODSMEDIC_HEAL_NAMESPACES=my-app,my-db
# Add the kinds to HEAL_KINDS to enable either action:
#   PODSMEDIC_HEAL_KINDS=...,PVCPending,VolumeMountFailed
# Cluster-wide brakes. Every other heal limit is per workload — the cooldown
# below, the circuit breaker, the playbook — so N distinct workloads failing at
# once passes all of them. These bound the sweep as a whole.
PODSMEDIC_HEAL_MAX_PER_SWEEP=3            # heals per sweep; 0 = unlimited (not advised)
# When this share of workloads is failing at once the cause is almost never the
# workloads: a node went away, storage stalled, a registry became unreachable.
# Healing suspends itself and says so, and resumes on its own when it clears.
PODSMEDIC_HEAL_SURGE_RATIO=0.25           # 0 disables the check
PODSMEDIC_HEAL_SURGE_MIN_WORKLOADS=8      # ratio needs a floor to mean anything

PODSMEDIC_HEAL_COOLDOWN=1h                # per-workload silence between heals
PODSMEDIC_HEAL_DENY_NAMESPACES=kube-system,kube-public,kube-node-lease
PODSMEDIC_HEAL_NAMESPACES=                # if set, the ONLY namespaces healed
# GitOps guard: workloads reconciled by ArgoCD/Flux/Helm are skipped by default,
# because an in-cluster patch would be reverted on the next sync. Set true only
# if you deliberately want podsmedic to patch them anyway.
PODSMEDIC_HEAL_ALLOW_GITOPS=false
# Verification: after HEAL_VERIFY_AFTER, re-check an applied heal; if the
# workload is still failing, roll it back to its prior values and alert. Only
# active with HEAL_APPLY=true (a dry run has nothing to verify). Pending heals
# are persisted in a ConfigMap so a restart does not forget them.
PODSMEDIC_HEAL_VERIFY=true
PODSMEDIC_HEAL_VERIFY_AFTER=10m
PODSMEDIC_HEAL_STATE_CONFIGMAP=podsmedic-heal-state

# Incident persistence: open incidents (and their pending heal proposals) are
# saved to a ConfigMap each sweep, so a restart continues them instead of
# re-alerting or re-diagnosing. Needs the ConfigMap RBAC from rbac-autoheal.yaml;
# writes are non-fatal if absent. Empty name disables (in-memory only).
PODSMEDIC_INCIDENT_STATE_CONFIGMAP=podsmedic-incident-state

# Audit trail: every applied/dry-run heal and every verify/rollback is appended
# to a ConfigMap with before/after values, for post-incident review. Bounded —
# the oldest events are dropped past the cap. Empty name disables the trail.
PODSMEDIC_AUDIT_CONFIGMAP=podsmedic-audit
PODSMEDIC_AUDIT_MAX_EVENTS=500

# Predictive heal: watch live memory AND CPU usage (metrics-server) and act
# BEFORE the failure. A container at/above RATIO of a limit for MIN_CHECKS
# consecutive sweeps raises MemoryPressure (→ raise memory limit) or CPUPressure
# (→ scale replicas), which heal like any other problem. Off by default
# (proactive mutation). To actually heal predictions, add MemoryPressure and/or
# CPUPressure to PODSMEDIC_HEAL_KINDS. Needs metrics-server.
PODSMEDIC_PREDICT=false
PODSMEDIC_PREDICT_MEMORY_RATIO=0.90       # usage/limit fraction considered near-limit
PODSMEDIC_PREDICT_MIN_CHECKS=3            # consecutive high sweeps before flagging

# Playbook: learn from verified heals. When a heal passes verification it is
# remembered (keyed by controller + problem kind); if the same workload hits the
# same problem again, the remembered fix is replayed directly — no LLM diagnosis,
# no cost — still re-validated and verified, and evicted if it ever stops holding.
# Needs autoheal on and the ConfigMap RBAC from rbac-autoheal.yaml. Empty disables.
PODSMEDIC_PLAYBOOK_CONFIGMAP=podsmedic-playbook
PODSMEDIC_PLAYBOOK_MAX_ENTRIES=500

# Circuit breaker: a workload whose heals keep failing is one podsmedic cannot
# fix; after too many rollbacks (or too-frequent heals) in the window, healing
# for that one workload is suspended and a human is alerted. Keyed by controller,
# so it spans pod restarts. In-memory: a podsmedic restart clears tripped breakers.
PODSMEDIC_HEAL_BREAKER=true
PODSMEDIC_HEAL_BREAKER_WINDOW=6h
PODSMEDIC_HEAL_BREAKER_MAX_HEALS=4          # heals in window that trip it (0 = off)
PODSMEDIC_HEAL_BREAKER_MAX_ROLLBACKS=2      # rollbacks in window that trip it (0 = off)
PODSMEDIC_HEAL_BREAKER_OPEN_FOR=6h          # how long healing stays suspended

# Observability: /healthz, /readyz, /metrics (Prometheus). Empty to disable.
PODSMEDIC_METRICS_ADDR=:9090

# Behaviour
PODSMEDIC_DRY_RUN=false          # print to stdout instead of Slack/Telegram
PODSMEDIC_LOG_LEVEL=info         # debug | info | warn | error
